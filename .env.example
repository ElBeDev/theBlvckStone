# Postgres (Neon, provisionado como integración nativa de Vercel;
# self-hosted en el VPS más adelante)
DATABASE_URL=

# Vercel Blob (subida de imágenes desde /admin)
BLOB_READ_WRITE_TOKEN=

# Login del panel /admin (una sola cuenta compartida por ahora)
